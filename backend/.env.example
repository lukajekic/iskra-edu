PORT=3000
MONGO_SECRET=mongodb://127.0.0.1:27017/iskra
JWT_SECRET=replace-with-a-long-random-secret

# Student AI mentor
AI_ENDPOINT=
AI_API_KEY=

# Iskra Planner and Canvas
GROQ_API_KEY=

# Event log privacy and retention
# If omitted, JWT_SECRET is used to create pseudonymous actor/source references.
EVENT_LOG_HMAC_SECRET=
EVENT_LOG_RETENTION_DAYS=30
# RapidAPI Judge0 CE. Store the RapidAPI key in backend environment only.
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_USER=
JUDGE0_AUTH_TOKEN_HEADER=x-rapidapi-key
JUDGE0_AUTH_USER_HEADER=X-Auth-User
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_PYTHON_LANGUAGE_ID=71
JUDGE0_RUBY_LANGUAGE_ID=72
JUDGE0_CALLBACK_BASE_URL=
JUDGE0_CALLBACK_SECRET=
