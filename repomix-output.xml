            </div>
            
          </div>
        ) : (
          <div className="text-center p-6 flex flex-col items-center gap-2">
            <Mail className="size-8 text-slate-300" />
            <p className="text-sm font-medium">Izaberite poruku iz liste da biste je pročitali</p>
