        return 'Učitavanje naslova...';
    };

    const handlePointsChange = (questionID: string, points: number) => {
        if (!test) return;

        const updatedQuestions = test.questions.map(q => {
            if (q.questionID === questionID) {
                return { ...q, points_max: points };
