                <span>{moment(activeMessage.date).format("D. MM. YYYY. HH:mm")}</span>
                {activeMessage?.target && (
                  <span className="text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full text-[11px] font-semibold">
