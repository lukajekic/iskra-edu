        password: approvalPass
      })

      if (response.status === 200) {
        toast.success("OK")
        setOpenAntiCheatValidationModal(false)
        setOpenCredentialModal(false)
        setapprovalPass("")
      }
    } catch (error) {
      toast.error("Pogresna lozinka!")
    }
  }


  useEffect(() => {
    const handleVisibilityChange = async() => {
