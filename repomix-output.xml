      if (response.status === 200) {
        toast.info("Kontrolni zadatak je predat.")
        closeFullscreen()
        navigate('/app/student/home')
      }
    } catch (error) {
      toast.error("Desila se greska.")
    }
  }

  const ValidateAntiCheat = async()=>{
