  dangerouslySetInnerHTML={{
    __html: item.taskDetails?.richText || ""
  }}
/>


      </HoverCardContent>
    </HoverCard>
          
        ))}


        <p className="text-lg font-semibold mt-5">Teorijski zadaci</p>

