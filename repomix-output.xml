/* ==========================================================================
   markdown-preview.css
   Samostalan stil za renderovani Markdown (react-markdown / bilo koji MD).
   Sve se kontroliÅ¡e preko CSS varijabli u .md-preview â€” menjaÅ¡ samo njih,
   ne diraÅ¡ selektore ispod.
   ========================================================================== */

.md-preview {
  /* â”€â”€ Boje (light mod, Apple Notes paleta) â”€â”€ */
  --md-text: #1d1d1f;          /* skoro crna â€” obiÄna paragraf boja, kao Notes */
  --md-heading: #1d1d1f;       /* naslovi â€” ista crna, samo bold nosi hijerarhiju */
  --md-muted: #86868b;         /* sivi sekundarni tekst (Apple sistemska siva) */
  --md-border: #cecece;        /* "ozbiljna" siva ivica â€” tabele, hr */
  --md-border-soft: #e5e5e5;   /* neÅ¡to svetlija linija za h1/hr */
  --md-bg-soft: #f5f5f7;       /* Apple pozadinska siva (header Ä‡elije, kod) */
  --md-accent: #007aff;        /* Apple sistemska plava (linkovi, markeri) */
  --md-accent-soft: rgb(0 122 255 / 6%);

  /* Kod */
  --md-code-bg: #f5f5f7;
  --md-code-text: #d63384;
  --md-pre-bg: #1d1d1f;
  --md-pre-text: #f5f5f7;
  --md-pre-border: #2c2c2e;

  /* Tipografija */
  --md-font-body: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
  --md-font-mono: ui-monospace, "SF Mono", "Fira Code", Consolas, monospace;
  --md-font-size: 1.0625rem;
  --md-line-height: 1.85;
  --md-radius: 0.625rem;

  /* Razmak â€” glavna "vazduÅ¡nost" celog dokumenta */
  --md-space: 1.75rem;

  color: var(--md-text);
  font-family: var(--md-font-body);
  font-size: var(--md-font-size);
  line-height: var(--md-line-height);
  max-width: none;
  -webkit-font-smoothing: antialiased;
}

/* â”€â”€ Dark mod: automatski (sistemski) ili preko klase .dark na pretku â”€â”€ */
.md-preview.dark,
.dark .md-preview {
  --md-text: #f5f5f7;
  --md-heading: #f5f5f7;
  --md-muted: #98989d;
  --md-border: #48484a;
  --md-border-soft: #3a3a3c;
  --md-bg-soft: #1c1c1e;
  --md-code-bg: #2c2c2e;
  --md-code-text: #ff7ab2;
  --md-pre-bg: #000;
  --md-pre-text: #f5f5f7;
  --md-pre-border: #2c2c2e;
}

/* ==========================================================================
   Naslovi
   ========================================================================== */
.md-preview h1,
.md-preview h2,
.md-preview h3,
.md-preview h4 {
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--md-heading);
  scroll-margin-top: 6rem;
}

.md-preview h1 {
  font-size: 1.875rem;
  padding-bottom: 1.25rem;
  margin-bottom: var(--md-space);
  border-bottom: 1px solid var(--md-border-soft);
}

.md-preview h2 {
  font-size: 1.3125rem;
  margin-top: calc(var(--md-space) * 1.6);
  margin-bottom: 1.25rem;
}

.md-preview h3 {
  font-size: 1.125rem;
  margin-top: calc(var(--md-space) * 1.3);
  margin-bottom: 1rem;
}

.md-preview h4 {
  font-size: 1rem;
  margin-top: var(--md-space);
  margin-bottom: 0.75rem;
  color: var(--md-muted);
}

/* prvi element odmah ispod naslova ne treba duplu prazninu */
.md-preview h1 + *,
.md-preview h2 + *,
.md-preview h3 + *,
.md-preview h4 + * {
  margin-top: 0;
}

/* ==========================================================================
   Paragrafi / inline tekst
   ========================================================================== */
.md-preview p {
  margin: var(--md-space) 0;
  color: var(--md-text);
}

.md-preview strong {
  font-weight: 600;
  color: var(--md-heading);
}

.md-preview em {
  font-style: italic;
}

.md-preview a {
  color: var(--md-accent);
  font-weight: 500;
  text-decoration: none;
  text-underline-offset: 3px;
}

.md-preview a:hover {
  text-decoration: underline;
}

/* ==========================================================================
   Liste
   ========================================================================== */
.md-preview ul,
.md-preview ol {
  margin: var(--md-space) 0;
  padding-left: 1.5rem;
}

.md-preview li {
  margin: 0.65rem 0;
  color: var(--md-text);
}

.md-preview ul {
  list-style: disc;
}

.md-preview ol {
  list-style: decimal;
}

.md-preview li::marker {
  color: var(--md-accent);
}

.md-preview li > ul,
.md-preview li > ol {
  margin-top: 0.4rem;
}

/* ==========================================================================
   Horizontalna linija
   ========================================================================== */
.md-preview hr {
  margin: calc(var(--md-space) * 1.6) 0;
  border: none;
  border-top: 1px solid var(--md-border-soft);
}

/* ==========================================================================
   Slike
   ========================================================================== */
.md-preview img {
  max-width: 100%;
  border-radius: var(--md-radius);
  border: 1px solid var(--md-border-soft);
  box-shadow: 0 1px 2px rgb(0 0 0 / 4%);
}

/* ==========================================================================
   Tabele
   ========================================================================== */
.md-preview .md-table-wrap {
  overflow-x: auto;
  margin: calc(var(--md-space) * 1.1) 0;
  border: 1px solid var(--md-border);
  border-radius: var(--md-radius);
}

.md-preview table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 0.9375rem;
}

/* prava "ozbiljna" mreÅ¾a â€” svaka Ä‡elija ima ivicu, ne samo redovi */
.md-preview th,
.md-preview td {
  border-right: 1px solid var(--md-border);
  border-bottom: 1px solid var(--md-border);
}

.md-preview th:last-child,
.md-preview td:last-child {
  border-right: none;
}

.md-preview thead {
  background: var(--md-bg-soft);
}

.md-preview th {
  padding: 0.85rem 1rem;
  text-align: left;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--md-heading);
  border-bottom: 1px solid var(--md-border);
}

.md-preview td {
  padding: 0.85rem 1rem;
  vertical-align: top;
  color: var(--md-text);
}

.md-preview tbody tr:last-child td {
  border-bottom: none;
}

/* bez zebra Å¡are â€” Äist, miran, "papirni" izgled kao Notes */
.md-preview tbody tr {
  background: transparent;
  transition: background-color 0.15s ease;
}

.md-preview tbody tr:hover {
  background: var(--md-bg-soft);
}

/* ==========================================================================
   Inline kod
   ========================================================================== */
.md-preview :not(pre) > code {
  background: var(--md-code-bg);
  color: var(--md-code-text);
  font-family: var(--md-font-mono);
  font-size: 0.85em;
  font-weight: 500;
  padding: 0.15em 0.4em;
  border-radius: 0.375rem;
}

/* ==========================================================================
   Blokovi koda
   ========================================================================== */
.md-preview pre {
  position: relative;
  margin: calc(var(--md-space) * 1.1) 0;
  padding: 2.25rem 1.25rem 1.25rem;
  background: var(--md-pre-bg);
  color: var(--md-pre-text);
  border: 1px solid var(--md-pre-border);
  border-radius: var(--md-radius);
  overflow-x: auto;
  font-size: 0.85em;
  line-height: 1.6;
}

/* simulirana "terminal" dugmad u zaglavlju bloka */
.md-preview pre::before {
  content: "";
  position: absolute;
  top: 0.9rem;
  left: 1rem;
  width: 0.6rem;
  height: 0.6rem;
  border-radius: 50%;
  background: #ef4444b3;
  box-shadow:
    1rem 0 0 #f59e0bb3,
    2rem 0 0 #10b981b3;
}

.md-preview pre code {
  background: transparent;
  color: inherit;
  padding: 0;
  font-family: var(--md-font-mono);
  font-weight: 400;
}

/* ==========================================================================
   Citati / napomene
   ========================================================================== */
.md-preview blockquote {
  margin: calc(var(--md-space) * 1.1) 0;
  padding: 1rem 1.5rem;
  font-style: normal;
  color: var(--md-text);
  background: var(--md-accent-soft);
  border-left: 4px solid var(--md-accent);
  border-radius: 0 var(--md-radius) var(--md-radius) 0;
}

.md-preview blockquote p {
  margin: 0.25rem 0;
}

/* ==========================================================================
   Å tampa / export u PDF
   ========================================================================== */
@media print {
  /* Štampa se isključivo generisani dokument, bez aplikacionog chrome-a i prompt forme. */
  body * {
    visibility: hidden;
  }

  .planner-print-area,
  .planner-print-area * {
    visibility: visible;
  }

  .planner-print-area {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: none;
    color: #000;
    background: #fff !important;
  }

  .md-preview {
    --md-text: #1d1d1f;
    --md-heading: #000;
    --md-border: #cecece;
    --md-bg-soft: #f5f5f7;
    --md-code-bg: #f5f5f7;
    --md-code-text: #000;
    --md-pre-bg: #f5f5f7;
    --md-pre-text: #000;
  }

  .md-preview pre {
    border: 1px solid var(--md-border);
    box-shadow: none;
    background: #fff !important;
    color: #000 !important;
  }

  .md-preview pre::before {
    display: none;
  }

  .md-preview table,
  .md-preview .md-table-wrap {
    box-shadow: none;
  }
}
